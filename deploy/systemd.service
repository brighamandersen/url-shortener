[Unit]
Description=short
After=network.target

[Service]
User=brig
Group=brig
Environment=NODE_ENV=production
WorkingDirectory=/home/brig/dev/url-shortener
ExecStart=/home/brig/.nvm/versions/node/v20.11.0/bin/node /home/brig/dev/url-shortener/app.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
